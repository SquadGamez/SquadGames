<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Squad Games Store TZ</title>
    <link rel="stylesheet" href="style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .portal-header-wrapper {
            background: var(--bg-card, rgba(22, 22, 26, 0.88));
            border: 1px solid var(--border-color, rgba(255, 255, 255, 0.08));
            border-radius: 16px;
            padding: 16px 20px;
            margin-bottom: 24px;
            backdrop-filter: blur(10px);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            position: sticky;
            top: 0;
            z-index: 999;
        }
        .portal-navbar {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            padding-bottom: 4px;
            scrollbar-width: none;
        }
        .portal-navbar::-webkit-scrollbar { display: none; }
        .portal-navbar .nav-tab {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            color: var(--text-muted, #94a3b8);
            padding: 7px 14px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 700;
            text-decoration: none;
            white-space: nowrap;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .portal-navbar .nav-tab:hover { background: rgba(255, 255, 255, 0.08); color: #fff; }
        .portal-navbar .nav-tab.active {
            background: var(--accent-blue, #007aff);
            color: #fff;
            box-shadow: 0 4px 12px rgba(0, 122, 255, 0.3);
        }
    </style>
</head>
<body>
    <div class="portal-header-wrapper">
        <div class="portal-logo-area" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <img src="images/profile.jpg" alt="Profile" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent-blue);">
                <h1 class="portal-logo" style="margin: 0;">SquadGames <span style="color: var(--accent-blue);">Store TZ</span></h1>
            </div>
        </div>
        <nav class="portal-navbar">
            <a href="index.html" class="nav-tab active" data-category="all">Home</a>
            <a href="#" class="nav-tab" data-category="action">Action</a>
            <a href="#" class="nav-tab" data-category="fighting">Fighting</a>
            <a href="#" class="nav-tab" data-category="shooting">Shooting</a>
            <a href="#" class="nav-tab" data-category="sports">Sports</a>
            <a href="#" class="nav-tab" data-category="racing">Racing</a>
            <a href="#" class="nav-tab" data-category="simulation">Simulation</a>
            <a href="#" class="nav-tab" data-category="all">All Categories</a>
            <a href="#" class="nav-tab" data-category="pc">PC Games</a>
            <a href="#" class="nav-tab" data-category="android">Mobile Games</a>
        </nav>
    </div>

    <div class="container">
        <div class="intro-banner">
            <h2>Welcome to Squad Games Store TZ</h2>
            <p>Your ultimate destination for high-speed racing, action-packed adventures, and custom Tanzanian mods.</p>
        </div>

        <div class="search-filter-section">
            <div class="search-bar-wrapper">
                <i class="fa-solid fa-magnifying-glass search-icon"></i>
                <input type="text" id="gameSearchInput" placeholder="Search games by title, keyword, or genre...">
            </div>
        </div>

        <div class="top-split-container">
            <div class="featured-epic-wrapper">
                <h3 class="section-title"><i class="fa-solid fa-fire"></i> Featured Epic Games</h3>
                <div class="featured-marquee-container">
                    <div class="featured-marquee-track" id="featuredTrack"></div>
                </div>
            </div>
            <div class="most-popular-wrapper">
                <h3 class="section-title"><i class="fa-solid fa-bolt"></i> Most Popular</h3>
                <div class="popular-list" id="popularList"></div>
            </div>
        </div>

        <h2 style="font-size: 1.2rem; font-weight: 800; margin: 30px 0 15px 0; color: #fff;">Game Library</h2>
        <div class="game-grid" id="gameGrid">
            <div class="loading-state"><div class="spinner"></div><p>Loading game catalog...</p></div>
        </div>

        <div class="footer-note">&copy; 2026 Squad Games Store TZ. Hosted via GitHub Pages.</div>
    </div>

    <script>
        let allGames = [];
        let activeCategory = 'all';
        let searchQuery = '';

        fetch('games.json')
            .then(res => res.json())
            .then(data => { allGames = data; initStore(); })
            .catch(err => { console.error(err); document.getElementById('gameGrid').innerHTML = '<p style="color: #ff4d4d;">Failed to load catalog.</p>'; });

        function initStore() {
            renderFeaturedAndPopular(allGames);
            filterAndRenderGrid();
            document.getElementById('gameSearchInput').addEventListener('input', (e) => {
                searchQuery = e.target.value.toLowerCase();
                filterAndRenderGrid();
            });
            document.querySelectorAll('.portal-navbar .nav-tab').forEach(tab => {
                tab.addEventListener('click', (e) => {
                    e.preventDefault();
                    document.querySelectorAll('.portal-navbar .nav-tab').forEach(t => t.classList.remove('active'));
                    e.target.classList.add('active');
                    activeCategory = e.target.getAttribute('data-category');
                    filterAndRenderGrid();
                });
            });
        }

        function filterAndRenderGrid() {
            const grid = document.getElementById('gameGrid');
            const filtered = allGames.filter(game => {
                const catLower = (game.category || '').toLowerCase();
                const platformLower = (game.platform || '').toLowerCase();
                const matchesCategory = (activeCategory === 'all' || catLower.includes(activeCategory) || platformLower.includes(activeCategory));
                const matchesSearch = ((game.title || '').toLowerCase().includes(searchQuery) || (game.description || '').toLowerCase().includes(searchQuery));
                return matchesCategory && matchesSearch;
            });

            if (filtered.length === 0) {
                grid.innerHTML = '<div class="loading-state"><p>No games found matching your search.</p></div>';
                return;
            }

            grid.innerHTML = filtered.map(game => {
                const gameId = game.id !== undefined ? game.id : game.title.toLowerCase().replace(/[^a-z0-9]/g, '-');
                // Correctly checking downloadUrl from your json
                const downloadUrl = game.downloadUrl || game.altDownloadUrl || '#';
                const primaryCat = game.category ? game.category.split('/')[0].trim().toUpperCase() : 'GAME';

                return `
                    <div class="game-card">
                        <span class="card-badge">${primaryCat}</span>
                        <div class="game-img-wrapper">
                            <img class="game-img" src="${game.image || 'images/default.jpg'}" alt="${game.title}" loading="lazy">
                        </div>
                        <div class="game-details">
                            <span class="category-tag">${game.category || game.platform}</span>
                            <h3>${game.title}</h3>
                            <p>${game.description || 'No description provided.'}</p>
                            <div class="card-action">
                                <span class="price">${game.price || 'FREE'}</span>
                                <div class="action-group">
                                    <a href="details.html?id=${gameId}" class="btn-details">Details &rarr;</a>
                                    <a href="${downloadUrl}" class="btn-action btn-download" target="_blank">Download</a>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function renderFeaturedAndPopular(games) {
            const marqueeTrack = document.getElementById('featuredTrack');
            const featured = games.slice(0, 6);
            marqueeTrack.innerHTML = [...featured, ...featured].map(game => {
                const gameId = game.id !== undefined ? game.id : game.title.toLowerCase().replace(/[^a-z0-9]/g, '-');
                return `
                    <div class="marquee-game-card">
                        <img class="marquee-game-img" src="${game.image || 'images/default.jpg'}" alt="${game.title}">
                        <div class="marquee-game-content">
                            <h4>${game.title}</h4>
                            <a href="details.html?id=${gameId}" class="btn-details" style="padding: 4px 8px; font-size: 0.75rem;">View</a>
                        </div>
                    </div>
                `;
            }).join('');

            const popularList = document.getElementById('popularList');
            popularList.innerHTML = games.slice(0, 5).map(game => {
                const gameId = game.id !== undefined ? game.id : game.title.toLowerCase().replace(/[^a-z0-9]/g, '-');
                return `
                    <a href="details.html?id=${gameId}" class="popular-item">
                        <img src="${game.image || 'images/default.jpg'}" alt="${game.title}">
                        <div class="popular-item-info"><h5>${game.title}</h5><span>${game.price || 'FREE'}</span></div>
                    </a>
                `;
            }).join('');
        }
    </script>
</body>
</html>
