<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Game Details - Squad Games Store TZ</title>
    <link rel="stylesheet" href="style.css"> <!-- Your main stylesheet -->
</head>
<body>
    <!-- Permanent Header -->
    <div id="nav-placeholder"></div>

    <div class="container" style="margin-top: 30px;">
        <a href="index.html" class="btn-details" style="display: inline-block; margin-bottom: 20px;">← Back to Home</a>
        
        <div id="gameDetailsContainer" class="game-details-page-wrapper">
            <!-- Dynamic content loaded via JS -->
            <div class="loading-state"><div class="spinner"></div><p>Loading game details...</p></div>
        </div>
    </div>

    <script>
        // Load Permanent Nav
        // (You can also copy-paste the HTML block from Step 2 directly here)

        // Fetch game data and render based on URL query parameter ?id=...
        const urlParams = new URLSearchParams(window.location.search);
        const gameId = urlParams.get('id');

        fetch('games.json') // Your game catalog JSON
            .then(res => res.json())
            .then(games => {
                const game = games.find(g => (g.id || g.title.toLowerCase().replace(/[^a-z0-9]/g, '-')) === gameId);
                const container = document.getElementById('gameDetailsContainer');

                if (!game) {
                    container.innerHTML = `<h2>Game not found</h2><p>The game you are looking for does not exist or was removed.</p>`;
                    return;
                }

                const smartCats = getSmartCategories(game);

                container.innerHTML = `
                    <div style="display: grid; grid-template-columns: 1fr 1.5fr; gap: 30px;" class="details-grid">
                        <div>
                            <img src="${game.image || 'images/default.jpg'}" alt="${game.title}" style="width: 100%; border-radius: 12px; object-fit: cover; border: 1px solid var(--border-color);">
                        </div>
                        <div>
                            <span class="card-badge">${smartCats[0].toUpperCase()}</span>
                            <h1 style="margin: 10px 0; font-size: 2rem;">${game.title}</h1>
                            <p style="color: var(--text-muted); font-size: 1rem; line-height: 1.6;">${game.description || 'No description provided.'}</p>
                            
                            <div class="specs-box">
                                <strong>Detected Categories:</strong> ${smartCats.join(', ')}<br>
                                <strong>Platform:</strong> ${game.platform || 'PC / Windows'}
                            </div>

                            <div style="margin-top: 25px; display: flex; gap: 12px; align-items: center;">
                                <span class="price" style="font-size: 1.5rem;">${game.price || 'FREE'}</span>
                                <a href="${game.downloadLink || '#'}" class="btn-action btn-download" target="_blank">Download Game</a>
                            </div>
                        </div>
                    </div>
                `;
            });

        // Include the smart categorizer function here as well
        function getSmartCategories(game) {
            let categories = new Set();
            if (game.category) categories.add(game.category.toLowerCase());
            const textCheck = (game.title + " " + (game.description || "")).toLowerCase();
            if (textCheck.match(/gta|grand theft auto|call of duty|action|battlefield/)) categories.add('action');
            if (textCheck.match(/tekken|street fighter|ufc|mortal kombat|fight/)) categories.add('fighting');
            if (textCheck.match(/shooting|gun|fps|sniper/)) categories.add('shooting');
            if (textCheck.match(/fifa|pes|sports|cricket/)) categories.add('sports');
            if (textCheck.match(/carx|nfs|racing|truck/)) categories.add('racing');
            if (textCheck.match(/apk|android|mobile/)) categories.add('mobile games');
            else categories.add('pc games');
            return Array.from(categories);
        }
    </script>
</body>
</html>